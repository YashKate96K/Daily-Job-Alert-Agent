# Tavily Search API Key (Get a free key at https://app.tavily.com)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Groq API Key (Get a free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Email Delivery Configuration (Gmail SMTP)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_app_password
EMAIL_RECIPIENT=your_email@gmail.com
